FROM docker.io/library/ubuntu:26.04

LABEL maintainer="Yuwsuke Kieda <yuw [at] seikando.info>"

# ── 環境変数 ──────────────────────────────────────────────
ENV TL_VERSION=2026 \
    TL_PATH=/usr/local/texlive \
    DEBIAN_FRONTEND=noninteractive \
    DEBCONF_NOWARNINGS=yes \
    TZ=Asia/Tokyo

# パッケージリポジトリ: 日本語 TeX 開発コミュニティ (texjp.org) の tlnet ミラー。
# さくらインターネット (大阪) にあり、CTAN の tlnet を反映している。
#
# current を指すため、取得されるのは常にその時点の最新パッケージであり、
# ビルド日によって構成が変わる（再現性はない）。
# 構成を固定したい場合は tlnet-archive のスナップショットに戻すこと:
#   ENV TL_REPO=https://www.texlive.info/tlnet-archive/2026/07/31/tlnet
#
# なお current は次期リリース (TL2027) が出た時点でそちらへ切り替わる。
# その場合は後段の「リリース年の検証」が失敗するので、
# 気付かないまま別リリースが入ることはない。
ENV TL_REPO=https://texlive.texjp.org/current/tlnet

ENV TEXMF_LOCAL_PATH=${TL_PATH}/texmf-local \
    TEXMF_DIST_PATH=${TL_PATH}/texmf-dist \
    TEXMF_VAR_PATH=${TL_PATH}/texmf-var \
    PATH=${TL_PATH}/bin/aarch64-linux:/bin:$PATH

# ── APT パッケージ ─────────────────────────────────────────
# perl-modules は必須。--no-install-recommends を付けると perl だけでは
# 入らず、install-tl が要求する Pod::Usage も debconf が使う Term::ReadLine も
# 欠落して "Can't locate Pod/Usage.pm in @INC" で失敗する。
# 名前が見つからない場合はバージョン付き（perl-modules-5.40 など）を指定する。
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
        wget \
        unzip \
        perl \
        perl-modules \
        ghostscript \
        zsh \
        fontconfig \
        tzdata \
        ca-certificates && \
    ln -sf /usr/share/zoneinfo/Asia/Tokyo /etc/localtime && \
    echo "Asia/Tokyo" > /etc/timezone && \
    apt-get autoremove -y && \
    apt-get clean && \
    rm -rf /var/cache/apt/archives/* /var/lib/apt/lists/*

# ── TeX Live インストール ───────────────────────────────────
# インストーラ・パッケージとも texjp.org の tlnet から取得する。
#
# scheme-full からドキュメント・ソースを除外する。
# profile のキー名は TL2017 で改称されており、旧名 option_doc / option_src は
# 現行の install-tl では未知キーとして黙って無視される（=doc/src が入る）。
# 必ず tlpdbopt_install_docfiles / tlpdbopt_install_srcfiles を使うこと。
# これらは tlpdb に永続化されるので、以後の tlmgr install にも効く。
WORKDIR /tmp

RUN mkdir install-tl-unx && \
    wget --retry-connrefused --tries=5 --waitretry=10 \
         -O /tmp/install-tl-unx.tar.gz \
         ${TL_REPO}/install-tl-unx.tar.gz && \
    tar -xz -C ./install-tl-unx --strip-components=1 \
        -f /tmp/install-tl-unx.tar.gz && \
    printf "%s\n" \
      "TEXDIR ${TL_PATH}" \
      "TEXMFLOCAL ${TEXMF_LOCAL_PATH}" \
      "TEXMFSYSVAR ${TEXMF_VAR_PATH}" \
      "TEXMFSYSCONFIG ${TL_PATH}/texmf-config" \
      "selected_scheme scheme-full" \
      "instopt_adjustpath 0" \
      "tlpdbopt_autobackup 0" \
      "tlpdbopt_install_docfiles 0" \
      "tlpdbopt_install_srcfiles 0" \
      > ./install-tl-unx/texlive.profile && \
    ./install-tl-unx/install-tl \
      -repository ${TL_REPO} \
      -profile ./install-tl-unx/texlive.profile && \
    rm -rf /tmp/*

# ── リリース年の検証 ───────────────────────────────────────
# TL_REPO が current を指すため、TL2027 リリース後は黙って TL2027 が
# 入ることになる。それを検出して確実に失敗させる安全弁。
# 意図してリリースを上げるときは TL_VERSION を書き換えること。
#
# release-texlive.txt の 1 行目は次の書式:
#   TeX Live (https://tug.org/texlive) version 2026
# "TeX Live 2026" では間に URL が挟まるためマッチしない。
RUN cat ${TL_PATH}/release-texlive.txt; \
    grep -qE "TeX Live.*version[[:space:]]+${TL_VERSION}" \
         ${TL_PATH}/release-texlive.txt || { \
      echo "ERROR: ${TL_REPO} does not provide TeX Live ${TL_VERSION}"; \
      echo "       (upstream may have moved to a newer release)"; \
      exit 1; \
    }

# ── doc / src 除外の検証 ───────────────────────────────────
# profile のキー名を間違えても install-tl は警告のみで成功してしまうため、
# 実際に doc/src が入っていないことをサイズで確認する安全弁。
RUN DOC_MB=$(du -sm ${TEXMF_DIST_PATH}/doc    2>/dev/null | cut -f1); DOC_MB=${DOC_MB:-0}; \
    SRC_MB=$(du -sm ${TEXMF_DIST_PATH}/source 2>/dev/null | cut -f1); SRC_MB=${SRC_MB:-0}; \
    echo "texmf-dist/doc=${DOC_MB}MB  texmf-dist/source=${SRC_MB}MB"; \
    tlmgr option docfiles; \
    tlmgr option srcfiles; \
    [ "${DOC_MB}" -lt 500 ] && [ "${SRC_MB}" -lt 200 ] || { \
      echo "ERROR: docfiles/srcfiles were installed despite the profile."; \
      echo "       Check the profile keys (tlpdbopt_install_docfiles / _srcfiles)."; \
      exit 1; \
    }

# ── tlmgr の既定リポジトリ固定と確認 ────────────────────────
# 以降の手動 tlmgr 操作も texjp.org を向くようにしておく。
RUN tlmgr option repository ${TL_REPO} && \
    tlmgr update --self --all && \
    tlmgr version && \
    tlmgr option repository

# ── CJKフォント・フォントキャッシュ設定 ─────────────────────
# cjk-gs-integrate は TeX Live 本体のパッケージを使う。
# TeX Live に統合されたコマンド名は拡張子なしの cjk-gs-integrate。
# cjk-gs-integrate.pl は GitHub/CTAN から直接取得した場合のファイル名で、
# TeX Live 経由では PATH に存在しない（exit 127 になる）。
RUN cjk-gs-integrate --cleanup --force && \
    cjk-gs-integrate --force && \
    mktexlsr && \
    luaotfload-tool -u -f && \
    printf "%s\n" \
      '<?xml version="1.0"?>' \
      '<!DOCTYPE fontconfig SYSTEM "fonts.dtd">' \
      '<fontconfig>' \
      "  <dir>${TEXMF_DIST_PATH}/fonts/opentype</dir>" \
      "  <dir>${TEXMF_DIST_PATH}/fonts/truetype</dir>" \
      "  <dir>${TEXMF_LOCAL_PATH}/fonts/opentype</dir>" \
      "  <dir>${TEXMF_LOCAL_PATH}/fonts/truetype</dir>" \
      '</fontconfig>' \
      > /etc/fonts/local.conf && \
    fc-cache -r

# ── Volume / 作業ディレクトリ ──────────────────────────────
# Podman rootless: UID/GID マッピングを考慮し、
# volume マウント先のディレクトリを作成してパーミッションを緩めておく
RUN mkdir -p ${TEXMF_VAR_PATH}/luatex-cache/generic/fonts/otl && \
    chmod 777 ${TEXMF_VAR_PATH}/luatex-cache/generic/fonts/otl

VOLUME ["/usr/local/texlive/texmf-var/luatex-cache/generic/fonts/otl"]

WORKDIR /workdir

# Podman rootless でホストユーザーとの UID マッピングが
# 自動的に行われるため、非 root ユーザーは不要な場合が多いが
# セキュリティポリシーに応じて以下のコメントを外すこと:
# RUN useradd -m -u 1000 texuser
# USER texuser

CMD ["/bin/zsh"]